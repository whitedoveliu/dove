{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dove",
  "version": "0.1.0",
  "identifier": "com.dove.app",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "title": "Dove",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
